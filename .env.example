# Example environment variables for local development and production deployments.
# Copy this file to .env and fill in secure values before running docker compose.

# Database
POSTGRES_PASSWORD=replace_postgres_password_here
TIMESCALEDB_PASSWORD=replace_timescaledb_password_here

# Backend DB connection overrides (optional)
AXION_POSTGRES_URL=jdbc:postgresql://postgres:5432/axion
AXION_TSDB_URL=jdbc:postgresql://timescaledb:5432/axion_ts

# OpenAI / AI key - prefer mounting into container via secret file in production
OPENAI_API_KEY=
AXION_OPENAI_KEY_FILE=/run/secrets/OPENAI_API_KEY

# Bootstrap admin user for first-time setup (change immediately in production)
AXION_BOOTSTRAP_ADMIN_USERNAME=demo_admin
AXION_BOOTSTRAP_ADMIN_PASSWORD=change_this_strong_password

# Grafana admin (for local dev only; use real secrets in production)
GF_SECURITY_ADMIN_PASSWORD=change_grafana_admin_password

# ML service DB connection (used by Axion-ML)
AXION_TSDB_URL_POSTGRES=postgresql://axion:change_me@timescaledb:5432/axion_ts

# ML integration settings
AXION_ML_CACHE_TTL=60
AXION_ML_AUTO_ESCALATE=false
AXION_ML_ESCALATION_THRESHOLD=0.7
AXION_ML_ESCALATION_HYSTERESIS=3
AXION_ML_ESCALATION_STREAK_TTL_SECONDS=300

# Notes:
# - Never commit real secrets to source control. Use a secret manager (Vault, AWS Secrets Manager, Azure Key Vault)
#   or Docker/Kubernetes secrets for production deployments.
# - For local testing, set values in .env (not committed) or export environment variables in your shell.
